{
  "name": "monica-docs-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:docs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:deployed-contract": "node scripts/test-deployed-site.mjs",
    "test:guide-prompts": "node scripts/test-guide-prompts.mjs",
    "validate:guide-prompts": "node scripts/validate-guide-prompts.mjs",
    "validate:guide-prompts:production": "node scripts/validate-guide-prompts.mjs --production",
    "validate:docs": "node scripts/validate-doc-content.mjs",
    "verify:manual-dotnet": "node scripts/verify-manual-dotnet.mjs",
    "verify:guide-release:production": "node scripts/verify-published-guide-release.mjs",
    "verify:deployed": "node scripts/verify-deployed-site.mjs",
    "check": "npm run validate:guide-prompts && npm run test:guide-prompts && npm run test:deployed-contract && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.2.10",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "lucide-react": "1.24.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
