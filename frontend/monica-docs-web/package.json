{
  "name": "monica-docs-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:docs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:deployed-contract": "node scripts/test-deployed-site.mjs",
    "test:guide-prompts": "node scripts/test-guide-prompts.mjs",
    "validate:guide-prompts": "node scripts/validate-guide-prompts.mjs",
    "validate:guide-prompts:production": "node scripts/validate-guide-prompts.mjs --production",
    "validate:docs": "node scripts/validate-doc-content.mjs",
    "verify:manual-dotnet": "node scripts/verify-manual-dotnet.mjs",
    "verify:guide-release:production": "node scripts/verify-published-guide-release.mjs",
    "verify:deployed": "node scripts/verify-deployed-site.mjs",
    "check": "npm run content:build && npm run validate:guide-prompts && npm run test:guide-prompts && npm run test:deployed-contract && npm run test:knowledge && npm run test:editorial && npm run lint && npm run typecheck && npm run build",
    "content:build": "node scripts/build-content.mjs",
    "predev": "npm run content:build",
    "prebuild": "npm run content:build",
    "test:knowledge": "node --test scripts/test-knowledge.mjs",
    "test:editorial": "node --test scripts/test-editorial-contracts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.2.10",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "github-slugger": "2.0.0",
    "lucide-react": "1.24.0",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/mdast": "4.0.4",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3"
  }
}
