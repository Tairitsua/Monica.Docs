{
  "ConnectionStrings": {
    "MonicaConfiguration": "Data Source=App_Data/monica-configuration-reset.sqlite"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DocumentationApi": {
    "DocumentGroupKey": "monica",
    "AssetBasePath": "/api/v1/Documentation/assets",
    "PreferredDocsMountPath": "/docs",
    "DocsSyncCronExpression": "0 */5 * * * *"
  },
  "Demo": {
    "DocumentationPortal": {
      "PortalTitle": "Monica Operator Docs",
      "SearchPageSize": 24,
      "PublicBaseUrl": "https://docs.dev.monica.local",
      "RequireLogin": true,
      "CacheTtl": "00:15:00",
      "DeploymentSlot": "Staging",
      "Theme": {
        "ThemeKey": "material",
        "EnableTableOfContents": true,
        "MaxHeadingDepth": 4
      },
      "Security": {
        "Authority": "https://identity.dev.monica.local",
        "ClientId": "monica-docs-dev",
        "ClientSecret": "development-only-secret",
        "MetadataRefreshInterval": "06:00:00"
      }
    },
    "DocumentationRouting": {
      "DefaultService": "docs",
      "Services": {
        "docs": {
          "DisplayName": "Documentation",
          "Endpoint": "https://docs.internal.local",
          "Enabled": true,
          "Weight": 80,
          "ConnectedDbs": [
            {
              "Name": "catalog",
              "Provider": "PostgreSQL",
              "ConnectionString": "Host=localhost;Database=docs_catalog;",
              "TimeoutSeconds": 30
            },
            {
              "Name": "search",
              "Provider": "Redis",
              "ConnectionString": "redis://localhost:6379/2",
              "TimeoutSeconds": 5
            }
          ],
          "FeatureFlags": {
            "semantic-search": true,
            "draft-preview": false
          }
        },
        "admin": {
          "DisplayName": "Admin Console",
          "Endpoint": "https://admin.internal.local",
          "Enabled": true,
          "Weight": 20,
          "ConnectedDbs": [
            {
              "Name": "audit",
              "Provider": "SqlServer",
              "ConnectionString": "Server=localhost;Database=docs_audit;",
              "TimeoutSeconds": 20
            }
          ],
          "FeatureFlags": {
            "bulk-publish": true,
            "danger-zone": false
          }
        }
      }
    },
    "DocumentationWorkflow": {
      "PipelineName": "docs-publish",
      "RunWindowStart": "2026-05-14T01:00:00",
      "Steps": [
        {
          "StepKey": "scan",
          "DisplayName": "Scan Markdown",
          "Enabled": true,
          "SortOrder": 10,
          "Retry": {
            "MaxAttempts": 3,
            "Delay": "00:00:05",
            "Backoff": "Exponential"
          }
        },
        {
          "StepKey": "index",
          "DisplayName": "Build Search Index",
          "Enabled": true,
          "SortOrder": 20,
          "Retry": {
            "MaxAttempts": 5,
            "Delay": "00:00:15",
            "Backoff": "Linear"
          }
        },
        {
          "StepKey": "publish",
          "DisplayName": "Publish Catalog",
          "Enabled": true,
          "SortOrder": 30,
          "Retry": {
            "MaxAttempts": 2,
            "Delay": "00:00:10",
            "Backoff": "None"
          }
        }
      ]
    }
  }
}
